# Tạo file `docker/mosquitto/passwd` trên máy quản trị / VPS bằng lệnh:
#   docker run --rm -v "$PWD/docker/mosquitto:/mosquitto/config" eclipse-mosquitto:2.0 \
#     mosquitto_passwd -c -b /mosquitto/config/passwd iot-node "<MQTT_PASSWORD>"
#   docker run --rm -v "$PWD/docker/mosquitto:/mosquitto/config" eclipse-mosquitto:2.0 \
#     mosquitto_passwd -b /mosquitto/config/passwd backend-svc "<MQTT_PASSWORD>"
# Không commit file `passwd` chứa mật khẩu thật lên Git.
