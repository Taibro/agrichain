  "clients": [
    {
      "clientId": "agrichain-web",
      "name": "AgriChain Web SPA",
      "description": "React SPA (Cloudflare Pages) — đăng nhập trực tiếp bằng Direct Access Grants",
      "rootUrl": "https://agrichain.pages.dev",
      "baseUrl": "/",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "frontchannelLogout": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "surrogateAuthRequired": false,
      "redirectUris": [
        "https://agrichain.pages.dev/*",
        "https://*.agrichain.pages.dev/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "https://agrichain.pages.dev",
        "https://*.agrichain.pages.dev",
        "http://localhost:5173"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://agrichain.pages.dev/*+http://localhost:5173/*",
        "display.on.consent.screen": "false",
        "token.grant.type.supported": "password, refresh_token"
      },
      "protocolMappers": [
        {
          "name": "audience-agrichain-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agrichain-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "username-map",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "agrichain-driver",
      "name": "AgriChain Driver App",
      "description": "React Native (Expo) app tai xế — Direct Access Grants (password grant, không redirect)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "display.on.consent.screen": "false",
        "token.grant.type.supported": "password, refresh_token"
      },
      "protocolMappers": [
        {
          "name": "audience-agrichain-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agrichain-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": ["profile", "roles"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "agrichain-api",
      "name": "AgriChain API (audience)",
